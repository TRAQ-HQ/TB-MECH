# --- Gnani AI Models (Prisma STT & Timbre TTS) ---
# If you have a single unified key, set GNANI_API_KEY.
# If Gnani gives you separate keys for STT and TTS, set them individually:
GNANI_API_KEY=
GNANI_STT_API_KEY=
GNANI_TTS_API_KEY=
GNANI_MOCK=1                         # 1 = mock mode for offline dev/tests; 0 = live API calls
GNANI_STT_LANGUAGE_DEFAULT=hi-IN     # hi-IN, ml-IN, ta-IN, en-IN
GNANI_TTS_VOICE_DEFAULT=Kaveri       # Kaveri, Pranav, Deepak, Shubhra

# --- Google Gemini Integration (Optional Speech Transcription & Reasoning) ---
GEMINI_API_KEY=

# --- Evon Sovereign LLM (P1, Optional OpenAI-compatible local server, e.g. vLLM) ---
LLM_MODE=template                    # template | evon
EVON_BASE_URL=http://localhost:8001/v1
EVON_MODEL=

# --- Server & Application Configuration ---
PORT=3000
NODE_ENV=development
