# --- Gnani (backend only; never expose in frontend or commit .env) ---
GNANI_API_KEY=
GNANI_MOCK=1                      # 1 = canned responses for dev; MUST be 0 for the final demo
GNANI_STT_LANGUAGE_DEFAULT=hi-IN
GNANI_TTS_VOICE_DEFAULT=Kaveri    # from HF card; VERIFY current voice list at docs.gnani.ai

# --- Evon (P1, self-hosted OpenAI-compatible server, e.g. vLLM) ---
LLM_MODE=template                 # template | evon
EVON_BASE_URL=http://localhost:8001/v1
EVON_MODEL=                       # fill after obtaining weights; do not guess the repo name

# --- App ---
MAX_UPLOAD_MB=5
RUNS_DIR=data/runs
